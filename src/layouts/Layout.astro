---
// styles first, so the base layer is declared before component CSS
import '../styles/broider.css';
import '../styles/tokens.css';
import '../styles/global.css';

import SMWHead from "../components/SMWHead.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
   title?: string;
   description?: string;
}

const { title = 'Oh, hello', description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width,initial-scale=1" />
      <title>{title}</title>
      {description && <meta name="description" content={description} />}
      <link rel="alternate" type="application/rss+xml" title="Soft Moon World Blog" href="/rss.xml" />
   </head>

   <body>
      <a class="skip-link" href="#content">Skip to content</a>
      <div class="page" id="top">
         <aside class="sidebar">
            <SMWHead />
            <Navigation />
         </aside>
         <div class="main-col">
            <marquee class="welcome">Welcome to my site.</marquee>
            <main class="content" id="content">
               <slot />
            </main>
         </div>
         <Footer />
      </div>
   </body>
</html>

<script src="../scripts/moon_title.ts"></script>
<script src="../scripts/reduced_motion.ts"></script>

<style>
   .page {
      display: grid;
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      grid-template-areas: "side main" "foot foot";
      gap: var(--space-5);
      min-height: 100vh;
      max-width: var(--page-max);
      margin: 0 auto;
      padding: var(--space-6) var(--space-5);
      align-items: start;
   }
   .sidebar {
      grid-area: side;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      position: sticky;
      top: var(--space-6);
   }
   .main-col {
      grid-area: main;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-width: 0;
   }
   .welcome {
      margin: 0;
      font-family: var(--font-mono);
      color: var(--color-text);
   }
   .skip-link {
      position: absolute;
      left: var(--space-4);
      top: calc(-1 * var(--space-7));
      padding: var(--space-2) var(--space-3);
      background: var(--color-surface);
      font-family: var(--font-mono);
      z-index: 1;
   }
   .skip-link:focus { top: var(--space-4); }
   .content {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--card-min)), 1fr));
      gap: var(--space-4);
   }

   @media (max-width: 720px) {
      .page {
         grid-template-columns: minmax(0, 1fr);
         grid-template-rows: auto 1fr auto;
         grid-template-areas: "side" "main" "foot";
         gap: var(--space-4);
         padding: var(--space-4);
      }
      .sidebar { position: static; }
   }
</style>
