---
import Card from './Card.astro';
import showData from '../data/performances.json';
---

<Card title="Performances" wide>
   <ul>
      {showData.map((show) => (
         <li><span class="date">{show.date}</span> <span>{show.loc}</span></li>
      ))}
   </ul>
</Card>

<style>
   ul {
      list-style: none;
      padding: 0;
   }
   li {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-1) 0;
   }
   li + li { border-top: 1px dotted var(--color-muted); }
   .date {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      color: var(--color-muted);
      align-self: center;
   }
</style>
